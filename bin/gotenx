#!/usr/bin/env python3
"""Entry point for the bundled gotenx CLI.

Adds the plugin root to sys.path so the ``gotenx`` package imports without an
install step, then dispatches to the CLI. Host-specific plugin-root variables
are honoured, while direct execution resolves the root from this file.
"""
import os
import sys
from pathlib import Path

PLUGIN_ROOT = Path(
    os.environ.get("GOTENX_PLUGIN_ROOT")
    or os.environ.get("CLAUDE_PLUGIN_ROOT")
    or os.environ.get("CODEX_PLUGIN_ROOT")
    or Path(__file__).resolve().parent.parent
)
sys.path.insert(0, str(PLUGIN_ROOT))

from gotenx.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
