{
  "schema_version": "gotenx.config.policy.v3",
  "_baseline_pending": true,

  "protected_metrics": {
    "panel_insight_survival_rate": {
      "method": "repeated_runs",
      "runs": 5,
      "tolerance": 0.02
    },
    "configured_diversity_index": {
      "method": "static_config",
      "tolerance": 0
    }
  },

  "protected_policy_keys": [
    "protected_metrics",
    "protected_policy_keys",
    "structural_invariants",
    "orchestration",
    "cost_budget",
    "benchmark"
  ],

  "structural_invariants": [
    "judge_provenance_policy",
    "no_proposal_metric_promotion",
    "ordered_stage_execution",
    "no_unmetered_run"
  ],

  "future_candidate_metrics": [
    {
      "name": "semantic_minority_survival_rate",
      "status": "unratified",
      "gating": false,
      "note": "Requires Eval-layer or clustering definition. Until ratified, never protected, never gating."
    }
  ],

  "panel": {
    "sources": ["claude", "codex", "opencode"]
  },

  "judge": {
    "source": "claude"
  },

  "orchestration": {
    "mode": "sequential",
    "readonly_agent": "gotenx-readonly",
    "stages": [
      {
        "id": "flash",
        "source": "flash",
        "role": "scout",
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "high",
        "max_items": 12,
        "max_content_chars": 800
      },
      {
        "id": "kimi",
        "source": "kimi",
        "role": "author",
        "model": "opencode-go/kimi-k2.7-code",
        "max_items": 10,
        "max_content_chars": 800
      },
      {
        "id": "deepseek_pro",
        "source": "deepseek_pro",
        "role": "critic",
        "model": "opencode-go/deepseek-v4-pro",
        "variant": "high",
        "max_items": 10,
        "max_content_chars": 800
      },
      {
        "id": "glm",
        "source": "judge",
        "role": "judge",
        "model": "opencode-go/glm-5.2",
        "max_items": 12,
        "max_content_chars": 800
      }
    ]
  },

  "cost_budget": {
    "reserve_per_run_usd": 0.10,
    "windows_usd": {"5h": 12.0, "7d": 30.0, "30d": 60.0},
    "max_baseline_ratio": 0.65,
    "pricing_snapshot": {
      "captured_at": "2026-06-18",
      "unit": "usd_per_million_tokens",
      "models": {
        "opencode-go/deepseek-v4-flash": {"input": 0.14, "output": 0.28, "cache_read": 0.0028},
        "opencode-go/kimi-k2.7-code": {"input": 0.95, "output": 4.0, "cache_read": 0.19},
        "opencode-go/deepseek-v4-pro": {"input": 1.74, "output": 3.48, "cache_read": 0.0145},
        "opencode-go/glm-5.2": {"input": 1.4, "output": 4.4, "cache_read": 0.26},
        "github-copilot/claude-opus-4.6": {"input": 5.0, "output": 25.0, "cache_read": 0.5},
        "github-copilot/gpt-5.5": {"input": 5.0, "output": 30.0, "cache_read": 0.5}
      }
    }
  },

  "benchmark": {
    "cases": 60,
    "noninferiority_margin": 0.10,
    "confidence": 0.95,
    "bootstrap_samples": 10000,
    "seed": 20260618,
    "baseline_models": [
      {"id": "github-copilot/claude-opus-4.6", "variant": "high"},
      {"id": "github-copilot/gpt-5.5", "variant": "high"}
    ],
    "capability_floor": {
      "dimension_mean_min": {
        "correctness": 3.25,
        "coverage": 3.0,
        "actionability": 3.0,
        "risk_testing": 2.75,
        "concision": 2.5
      },
      "case_mean_min": 2.75,
      "case_correctness_min": 2.5,
      "min_case_pass_rate": 0.9,
      "max_critical_failure_rate": 0.05,
      "critical_failure_votes_required": 2
    }
  },

  "eval": {
    "provenance_faithful": {
      "sample_k": 5,
      "threshold": 0.90
    }
  }
}
